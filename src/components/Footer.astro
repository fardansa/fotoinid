---
---

<footer class="bg-[#1b1722] text-[#f8f5fa] pt-16 pb-10 border-t border-[#342e3e]">
  <div class="max-w-[1240px] mx-auto px-6 md:px-10">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-[#352f40]">
      
      <!-- Brand & Tagline -->
      <div class="md:col-span-5 space-y-4">
        <a href="#top" class="text-white font-extrabold text-3xl tracking-tight inline-flex items-center gap-1 group">
          <span>foto</span>
          <span class="text-[#c7a7ff] group-hover:scale-125 transition-transform duration-300">.</span>
          <span>in</span>
          <span class="text-[#c7a7ff]">.id</span>
        </a>
        <p class="text-[#c8c1ce] text-sm max-w-sm leading-relaxed">
          Mengabadikan momen dengan cerita. Dokumentasi visual wisuda, aksi pertunjukan, dan kegiatan bermakna.
        </p>
        <div class="pt-2 flex items-center gap-3 text-xs text-[#a39bae]">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Menerima pemesanan jadwal sesi foto</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#c7a7ff]">
          Jelajahi
        </h4>
        <nav class="flex flex-col space-y-2.5 text-sm text-[#eee9f4]">
          <a href="#top" class="hover:text-[#d6b4ff] transition-colors">Beranda</a>
          <a href="#work" class="hover:text-[#d6b4ff] transition-colors">Pilihan Karya</a>
          <a href="#services" class="hover:text-[#d6b4ff] transition-colors">Layanan</a>
          <a href="#about" class="hover:text-[#d6b4ff] transition-colors">Tentang Kami</a>
          <a href="#contact" class="hover:text-[#d6b4ff] transition-colors">Kontak & Reservasi</a>
        </nav>
      </div>

      <!-- Categories & Services -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#c7a7ff]">
          Fokus Layanan
        </h4>
        <p class="text-sm text-[#c8c1ce] leading-relaxed space-y-1">
          <span class="block">🎓 Dokumentasi Wisuda & Mahasiswa</span>
          <span class="block">🥋 Aksi Pertunjukan & Bela Diri</span>
          <span class="block">👥 Kegiatan Organisasi & Himpunan Kampus</span>
          <span class="block">🎉 Event Panggung & Dokumentasi Momen</span>
        </p>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#9d95a6]">
      <div>
        <span>© {new Date().getFullYear()} foto.in.id · Semua Hak Dilindungi.</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="#top" class="text-[#c7a7ff] hover:underline flex items-center gap-1 font-semibold">
          <span>Kembali ke atas</span>
          <span>↑</span>
        </a>
      </div>
    </div>

  </div>
</footer>
