---
const servicesList = [
  {
    num: '01',
    title: 'Wisuda & Kelulusan',
    shortDesc: 'Dokumentasi kelulusan, toga, portrait keluarga & sahabat.',
    details: 'Sesi foto outdoor atau indoor dengan konsep candid dan formal yang berkesan. Termasuk arahan pose natural.',
    tag: 'Favorite Wisudawan',
  },
  {
    num: '02',
    title: 'Organisasi & Kampus',
    shortDesc: 'Dokumentasi kegiatan kepengurusan, pelantikan, & dinamika tim.',
    details: 'Liputan lengkap agenda organisasi, foto pengurus, company profile internal, hingga dokumentasi seremonial.',
    tag: 'Komunitas & BEM',
  },
  {
    num: '03',
    title: 'Event & Panggung',
    shortDesc: 'Dokumentasi konser, festival, aksi seni bela diri, & pertunjukan malam.',
    details: 'Kemampuan teknis tinggi dalam pencahayaan dinamis & low-light untuk menangkap aksi berkecepatan tinggi.',
    tag: 'Low-Light Specialist',
  },
  {
    num: '04',
    title: 'Portrait & Kustom',
    shortDesc: 'Sesi portrait personal, produk, creative photoshoot, atau request khusus.',
    details: 'Konsep fleksibel sesuai visi dan cerita yang ingin Anda bangun. Konsultasikan ide Anda bersama kami.',
    tag: 'Custom Concept',
  },
];
---

<section id="services" class="py-24 bg-[#fffefa] border-b border-[#d8d4db]">
  <div class="max-w-[1240px] mx-auto px-6 md:px-10">
    
    <!-- Section Header -->
    <div class="border-b border-[#d8d4db] pb-6 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#773be8] mb-2 flex items-center gap-2">
          <span>03 — Layanan Kami</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#ee4ca0]"></span>
        </div>
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-[#211f24] leading-tight">
          Untuk setiap momen yang berarti.
        </h2>
      </div>
      <p class="text-xs uppercase tracking-wider text-[#77727b] font-medium">
        Layanan Fotografi Komprehensif
      </p>
    </div>

    <!-- Service Rows -->
    <div class="divide-y divide-[#d8d4db] border-t border-[#d8d4db]">
      {servicesList.map((srv) => (
        <div class="py-8 md:py-10 group hover:bg-[#f6f3fa] transition-colors duration-300 px-4 md:px-6 rounded-2xl">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            
            <!-- Number -->
            <div class="md:col-span-1 flex items-center gap-3">
              <span class="text-xs md:text-sm font-black tracking-widest text-[#773be8] font-mono">
                {srv.num}
              </span>
            </div>

            <!-- Title & Tag -->
            <div class="md:col-span-4">
              <div class="flex items-center gap-3">
                <h3 class="text-2xl md:text-3xl font-extrabold text-[#211f24] group-hover:text-[#773be8] transition-colors">
                  {srv.title}
                </h3>
              </div>
              <span class="inline-block mt-2 text-[10px] font-bold uppercase tracking-wider text-[#773be8] bg-[#eee8f8] px-2.5 py-1 rounded">
                {srv.tag}
              </span>
            </div>

            <!-- Description -->
            <div class="md:col-span-6 text-sm text-[#5a5460] leading-relaxed">
              <p class="font-medium text-[#211f24] mb-1">{srv.shortDesc}</p>
              <p class="text-xs text-[#77727b]">{srv.details}</p>
            </div>

            <!-- Action Button -->
            <div class="md:col-span-1 flex justify-start md:justify-end">
              <a 
                href="#contact" 
                class="w-10 h-10 rounded-full border border-[#d8d4db] group-hover:border-[#773be8] group-hover:bg-[#773be8] group-hover:text-white flex items-center justify-center text-[#773be8] transition-all duration-300"
                aria-label={`Pesan layanan ${srv.title}`}
              >
                <span class="text-lg leading-none transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Note under services -->
    <div class="mt-8 pt-4 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-[#77727b] gap-3">
      <span>* Semua layanan mencakup kurasi foto, color grading presisi, dan file resolusi penuh tanpa kompresi.</span>
      <a href="#contact" class="text-[#773be8] font-bold hover:underline">Konsultasikan kebutuhan fotografi Anda →</a>
    </div>

  </div>
</section>
