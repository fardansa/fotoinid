---
---

<section class="bg-[#1b1722] text-[#f8f5fa] py-24 border-y border-[#342e3e] relative overflow-hidden">
  <!-- Subtle purple glow in background -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#773be8]/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#ee4ca0]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1240px] mx-auto px-6 md:px-10 relative z-10">
    <!-- Header -->
    <div class="border-b border-[#3e3848] pb-6 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#d2b9ff] mb-2 flex items-center gap-2">
          <span>02 — Karya Pilihan</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#ee4ca0]"></span>
        </div>
        <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Momen yang menyala.
        </h2>
      </div>
      <p class="text-xs uppercase tracking-wider text-[#b2a9bb] font-medium">
        Foto Pilihan · Semburan Api Pertunjukan
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Text Description -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-block px-3 py-1 rounded bg-[#773be8]/20 border border-[#773be8]/40 text-[#d2b9ff] text-xs uppercase tracking-widest font-semibold">
          High-Speed Capture
        </div>
        <h3 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Energi dalam satu frame.
        </h3>
        <p class="text-[#c8c1ce] text-base leading-relaxed">
          Gerak dan kobaran cahaya menjadi pusat perhatian. Mengabadikan pecahan detik di saat api berkobar memerlukan presisi shutter speed dan kepekaan menangkap emosi pertunjukan.
        </p>

        <!-- Feature Specs -->
        <div class="pt-4 grid grid-cols-2 gap-4 border-t border-[#3e3848]">
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10">
            <span class="block text-xs uppercase tracking-wider text-[#d2b9ff] font-bold">Teknik</span>
            <span class="text-sm font-semibold text-white">Low Light Shutter Sync</span>
          </div>
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10">
            <span class="block text-xs uppercase tracking-wider text-[#d2b9ff] font-bold">Kategori</span>
            <span class="text-sm font-semibold text-white">Pertunjukan Seni & Aksi</span>
          </div>
        </div>

        <div class="pt-2">
          <a 
            href="#contact" 
            class="inline-flex items-center gap-3 bg-[#773be8] hover:bg-[#642ecb] text-white font-bold text-xs uppercase tracking-widest px-6 py-3.5 rounded-full transition-all shadow-lg hover:shadow-[#773be8]/40"
          >
            <span>Booking Dokumentasi Event</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Feature Image -->
      <div class="lg:col-span-7">
        <div 
          class="group relative overflow-hidden rounded-3xl bg-[#29242e] border border-[#484052] shadow-2xl cursor-pointer"
          id="feature-image-card"
          data-src="/photo/IMG_2197.jpg"
          data-title="Semburan Api Spektakuler"
          data-category-label="Karya Pilihan · Pertunjukan"
          data-desc="Aksi semburan api dengan nyala besar di depan penonton pada pertunjukan malam hari."
        >
          <img 
            src="/photo/IMG_2197.jpg" 
            alt="Aksi semburan api dengan nyala besar di depan penonton"
            loading="lazy"
            class="w-full h-[400px] md:h-[480px] object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>

          <!-- Bottom Floating Badge -->
          <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between pointer-events-none">
            <div class="bg-black/60 backdrop-blur-md border border-white/20 px-4 py-2.5 rounded-xl">
              <span class="block text-white font-bold text-sm">Semburan Api</span>
              <span class="text-[10px] text-[#f0c9ff] uppercase tracking-wider">Dokumentasi Pertunjukan Malam</span>
            </div>
            <div class="bg-white/20 backdrop-blur-md p-2.5 rounded-full text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const featureCard = document.getElementById('feature-image-card');
  featureCard?.addEventListener('click', () => {
    const src = featureCard.getAttribute('data-src');
    const title = featureCard.getAttribute('data-title');
    const desc = featureCard.getAttribute('data-desc');
    const cat = featureCard.getAttribute('data-category-label');

    window.dispatchEvent(
      new CustomEvent('open-lightbox', {
        detail: { src, title, desc, category: cat, index: 1 },
      })
    );
  });
</script>
