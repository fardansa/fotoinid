---
import { photos } from '../data/photos';
---

<!-- Lightbox Modal -->
<div 
  id="lightbox-modal" 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 md:p-10 bg-black/90 backdrop-blur-xl transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-label="Penampil Foto"
>
  <!-- Close Button Top Right -->
  <button 
    id="lightbox-close" 
    class="absolute top-5 right-5 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center backdrop-blur-md transition-all cursor-pointer focus:outline-none"
    aria-label="Tutup penampil foto"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <!-- Prev Button -->
  <button 
    id="lightbox-prev" 
    class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white hidden sm:flex items-center justify-center backdrop-blur-md transition-all cursor-pointer focus:outline-none"
    aria-label="Foto sebelumnya"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <!-- Next Button -->
  <button 
    id="lightbox-next" 
    class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 text-white hidden sm:flex items-center justify-center backdrop-blur-md transition-all cursor-pointer focus:outline-none"
    aria-label="Foto berikutnya"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <!-- Lightbox Content Container -->
  <div class="relative z-10 max-w-5xl w-full max-h-[90vh] flex flex-col items-center justify-center">
    
    <!-- Image Wrapper -->
    <div class="relative w-full flex items-center justify-center overflow-hidden rounded-2xl max-h-[72vh]">
      <img 
        id="lightbox-img" 
        src="" 
        alt="" 
        class="max-w-full max-h-[72vh] object-contain rounded-xl shadow-2xl transition-all duration-300"
      />
    </div>

    <!-- Metadata & Caption Bar -->
    <div class="w-full mt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-white">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span id="lightbox-category" class="text-[10px] uppercase font-bold tracking-widest text-[#d6b4ff] bg-[#773be8]/40 px-2.5 py-0.5 rounded-full border border-white/10"></span>
          <span id="lightbox-counter" class="text-xs text-white/50 font-mono"></span>
        </div>
        <h4 id="lightbox-title" class="text-lg md:text-xl font-bold tracking-tight text-white"></h4>
        <p id="lightbox-desc" class="text-xs text-white/75 mt-0.5 line-clamp-2 max-w-xl"></p>
      </div>

      <!-- Action Button (Open Full Resolution) -->
      <div class="flex items-center gap-2">
        <a 
          id="lightbox-download" 
          href="" 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold uppercase tracking-wider text-white border border-white/20 transition-all flex items-center gap-1.5"
        >
          <span>Resolusi Penuh</span>
          <span class="text-xs">↗</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script define:vars={{ photos }}>
  const modal = document.getElementById('lightbox-modal');
  const img = document.getElementById('lightbox-img');
  const title = document.getElementById('lightbox-title');
  const desc = document.getElementById('lightbox-desc');
  const cat = document.getElementById('lightbox-category');
  const counter = document.getElementById('lightbox-counter');
  const downloadLink = document.getElementById('lightbox-download');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let currentIndex = 0;

  const updateModalContent = (index) => {
    currentIndex = (index + photos.length) % photos.length;
    const photo = photos[currentIndex];
    if (!photo) return;

    const src = `/photo/${photo.filename}`;
    if (img) {
      img.src = src;
      img.alt = photo.title;
    }
    if (title) title.textContent = photo.title;
    if (desc) desc.textContent = photo.description;
    if (cat) cat.textContent = photo.categoryLabel;
    if (counter) counter.textContent = `${currentIndex + 1} / ${photos.length}`;
    if (downloadLink) {
      downloadLink.href = src;
    }
  };

  const openModal = (index) => {
    updateModalContent(index);
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    setTimeout(() => {
      modal?.classList.remove('opacity-0');
      modal?.classList.add('opacity-100');
    }, 10);
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    modal?.classList.add('opacity-0');
    modal?.classList.remove('opacity-100');
    setTimeout(() => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }, 300);
  };

  // Event listener for opening lightbox
  window.addEventListener('open-lightbox', (e) => {
    const detail = e.detail;
    openModal(detail.index ?? 0);
  });

  // Controls
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  prevBtn?.addEventListener('click', () => updateModalContent(currentIndex - 1));
  nextBtn?.addEventListener('click', () => updateModalContent(currentIndex + 1));

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('flex')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') updateModalContent(currentIndex - 1);
    if (e.key === 'ArrowRight') updateModalContent(currentIndex + 1);
  });
</script>
